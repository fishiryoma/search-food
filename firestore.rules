rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 所有 Firestore 存取只透過 Cloud Functions 的 Admin SDK 進行
    // （places_cache / rate_limits / global_usage），前端從不直接連線 Firestore，
    // 因此明確拒絕所有 client SDK / REST API 存取。Admin SDK 不受此規則約束。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
